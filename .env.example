# HTTP listen address.
CORE_ADDR=:8080

# debug, info, warn, or error.
CORE_LOG_LEVEL=info

# Graceful shutdown budget after SIGINT or SIGTERM.
CORE_SHUTDOWN_TIMEOUT=10s

# Web app origin used to validate GitHub callback redirects.
CORE_APP_ORIGIN=http://localhost:3000

# Optional HMAC secret for GitHub App connect state. Falls back to SUPABASE_JWT_SECRET.
CORE_STATE_SECRET=

# Supabase project URL (used as JWT issuer {url}/auth/v1 when set).
SUPABASE_URL=https://your-project.supabase.co

# HS256 secret from Supabase Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# Service-role API key. Never expose this to the browser or log it.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres URL for the service-role / postgres user (pgmq + RLS bypass).
# SUPABASE_DB_URL is accepted as an alias.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# GitHub App (owned by Core). Never commit real values. Never log the private key.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://localhost:8080/v1/integrations/github/callback
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
